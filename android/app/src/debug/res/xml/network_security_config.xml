<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app reach a local API over plain HTTP during development
     (localhost via `adb reverse`, or 10.0.2.2 = the host machine from the emulator).
     Release builds keep Android's default of HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
