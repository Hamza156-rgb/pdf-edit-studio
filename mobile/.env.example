# Where the native app reaches the Editly server (the website's Express API).
# Release builds read .env.production; override for local device testing, e.g.
#   VITE_API_BASE_URL=http://localhost:3000 pnpm android     (with `adb reverse tcp:3000 tcp:3000`)
VITE_API_BASE_URL=https://api.your-domain.com

# Browser preview (`pnpm dev`) proxies /api to this server instead.
API_PROXY_TARGET=http://localhost:3000
