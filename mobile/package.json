{
  "name": "editly-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Editly mobile app (Ionic React + Capacitor). Shares the editor and API client with the website in ../client.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cap sync",
    "typecheck": "tsc --noEmit",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "assets": "npx @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor \"#0f172a\" --splashBackgroundColor \"#0f172a\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/react": "9.0.10",
    "@ionic/react-router": "9.0.10",
    "@tanstack/react-query": "5.90.2",
    "@trpc/client": "11.6.0",
    "@trpc/react-query": "11.6.0",
    "lucide-react": "0.453.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "sonner": "2.0.7",
    "superjson": "1.13.3",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.7"
  }
}
